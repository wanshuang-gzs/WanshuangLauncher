{
  "name": "wanshuang-launcher",
  "version": "1.1.0",
  "description": "Wanshuang Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:dir": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.wanshuang.launcher",
    "productName": "Wanshuang Launcher",
    "icon": "public/app.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "logo.png",
      "logo.ico",
      "public/**/*",
      "src/**/*",
      "splash/**/*",
      "bot/**/*",

      "package.json"
    ],
    "win": {
      "icon": "public/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/app.ico",
      "uninstallerIcon": "public/app.ico",
      "uninstallDisplayName": "Wanshuang Launcher",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wanshuang Launcher",
      "artifactName": "WanshuangLauncher-Setup-1.1.0.exe"
    },
    "extraResources": [
      {
        "from": "terracotta-bin",
        "to": "terracotta"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^1.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "mineflayer": "^4.20.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "node-fetch": "2.x",
    "qrcode": "^1.5.4",
    "tslib": "^2.6.2",
    "ws": "^8.21.1"
  }
}
